#:kivy 2.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# ═══════════════════════════════════════════════════════════════════════════════
#  ASSETS.KV — Icon and graphic asset definitions for SoundHealer
#
#  All icons use KivyMD's MDIcon widget which renders Material Design Icons
#  from the bundled icon font — guaranteed to work on every Android device.
#
#  Usage in Python:
#      from kivy.lang import Builder
#      Builder.load_file('assets.kv')
#  Then use AppIcon(icon='heart', icon_color=RED) anywhere.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Reusable icon widget ───────────────────────────────────────────────────────
<AppIcon@MDIcon>:
    # Size defaults — override per instance
    size_hint:  None, None
    size:       dp(28), dp(28)
    halign:     'center'
    valign:     'middle'
    font_size:  sp(22)

# ── Small icon (nav bars, badges) ─────────────────────────────────────────────
<AppIconSm@MDIcon>:
    size_hint:  None, None
    size:       dp(20), dp(20)
    halign:     'center'
    valign:     'middle'
    font_size:  sp(16)

# ── Large decorative icon (screen headers, home tiles) ────────────────────────
<AppIconLg@MDIcon>:
    size_hint:  None, None
    size:       dp(40), dp(40)
    halign:     'center'
    valign:     'middle'
    font_size:  sp(32)


# ═══════════════════════════════════════════════════════════════════════════════
